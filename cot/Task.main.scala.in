//package main.scala.in

import _root_.cats.data.OptionT

import _root_.zio.interop.catz.*


implicit val πTaskConsoleInstance: _root_.cats.effect.std.Console[zio.Task] =
  _root_.cats.effect.std.Console.make[zio.Task]


object App extends CatsApp:

  import _root_.cats.syntax.functor.*
  import _root_.cats.syntax.flatMap.*
  import _root_.cats.effect.{ Concurrent, Deferred, Ref, Resource }
  import _root_.cats.effect.syntax.monadCancel.*
  import _root_.cats.effect.syntax.spawn.*

  import _root_.zio.{ ExitCode, ZIOAppArgs, ZIO }

  override def run: ZIO[ZIOAppArgs, Throwable, Unit] =
    for
      args <- getArgs
      code <-
        ( for
            given Deferred[[X] =>> OptionT[π.F, X], Unit] <- Resource.eval(Deferred[[X] =>> OptionT[π.F, X], Unit])
            stop <- Resource.eval(Deferred[[X] =>> OptionT[π.F, X], Unit])
            _ <- π.Main[π.F](args.toSeq*).guarantee((given_Deferred_OptionT_Unit.complete(()) >> stop.complete(())).void).background
          yield
            given_Deferred_OptionT_Unit -> stop
        ).use { (signal, stop) =>
          Concurrent[[X] =>> OptionT[π.F, X]].race(Concurrent[[X] =>> OptionT[π.F, X]].never, signal.get).onCancel(signal.complete(()).void).guarantee(stop.get)
        }.fold(ExitCode.failure)(_ => ExitCode.success)
      _    <- exit(code)
    yield
      ()


object π:

  import _root_.scala.collection.immutable.{ List => πLs }
  import _root_.scala.concurrent.duration.*

  import _root_.cats.*
  import _root_.cats.instances.list.*
  import _root_.cats.syntax.all.*

  import _root_.cats.effect.*
  import _root_.cats.effect.std.Semaphore

  import _root_.eu.timepit.refined.*

  import Π.*


  extension [F[_]: Concurrent: Parallel](self: πLs[OptionT[F, Unit]])
    private[π] inline def πparSequence: OptionT[F, Unit] =
      self.parSequenceVoid
    private[π] inline def πparSequence(semaphore: Semaphore[F]): OptionT[F, Unit] =
      self.map(_.value).map(OptionT.whenM(semaphore.tryAcquire)(_)).parSequenceVoid


