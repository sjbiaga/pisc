# -*- indent-tabs-mode: nil; -*-

⟦ include = ce ⟧

@def println(a: Any) = IO.println(a)

⟦ include = zio ⟧

@def println(a: Any) = ZIO.debug(a)

⟦ exclude = 0 ⟧

⟦ 'n be 'm `.` 'P ⟧ = m[ out n. open n. P{} ] | in m.

Main = ν(w) w[ ν(n, m) n[ ⟦ n be m . ν(k) ( ( go k. τ/*_ <- println("P")*/. ) | k[ τ/*_ <- println("Q")*/. ] ) ⟧ ] ]
