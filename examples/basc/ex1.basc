# -*- indent-tabs-mode: nil; -*-

⟦ INCLUDE = (ce,cef) ⟧

@val in: BigDecimal => IO[BigDecimal] = IO.pure(_).flatTap { z => IO.println(s"in $z") }

@def log(a: Any): Any => IO[Any] = IO.pure(_) <* IO.println(a)

⟦ INCLUDE = fs2 ⟧

@import cats.effect.std.Console

@val in: BigDecimal => F[BigDecimal] = Async[F].pure(_).flatTap { z => Console[F].println(s"in $z") }

@def println(a: Any) = Console[F].println(a)

@def log(a: Any): Any => F[Any] = Async[F].pure(_) <* Console[F].println(a)

⟦ TYPECLASSES = (Async,cats.effect.std.Console,Parallel) ⟧

⟦ INCLUDE = (zio,ziof,zs) ⟧

@val in: BigDecimal => Task[BigDecimal] = ZIO.succeed(_).tap { z => ZIO.debug(s"in $z") }

@def log(a: Any): Any => Task[Any] = ZIO.succeed(_) <* ZIO.debug(a)

⟦ INCLUDE = zs ⟧

@def println(a: Any) = ZIO.debug(a)

                                                            ⟦ EXCLUDE = 0 ⟧{ex1}

⟦ REPLICATION = (LINEAR,no) ⟧

⟦ TRACES = console ⟧

⟦ EXCLUDE = yes ⟧

P(x) = (!. local x@∞ ! { 1 } /*println("out 1")*/.) | (!. local x@∞ ? { z } /*in*/.)

Q(x) = "l"[ !. s2s x@∞ ! { 2 } /*println("out 2")*/. ] | "r"[ !. s2s x@∞ ? { z } /*in*/. ]

R(x) = "p"[ "c"[ !. c2p x@∞ ! { 3 } /*println("out 3")*/. ] | ( !. p2c x@∞ ? { z } /*in*/. ) ]

Main = ν(x) "r"[ P(x) | Q(x) | R(x) ]

⟦ EXCLUDE = no ⟧

P = ν(x) [ "l"[ accept x /*println("accepted")*/. ] | "r"[ enter x /*println("entered")*/. ] ]

Q = ν(x) "p"[ "c"[ exit x /*println("exited")*/. ] | expel x /*println("expelled")*/. ]

R = ν(x) "r"[ "+"[ merge+ x /*println("merged+")*/. ] | "-"[ merge- x /*println("merged-")*/. ] ]

Main = P | Q | R

⟦ EXCLUDE = yes ⟧

C(x) = exit x /*println("exited")*/. s2s x?{y}. enter y /*println("entered")*/. C(y)

P(x) = expel x /*println("expelled")*/. s2s x!{νy}. accept y /*println("accepted")*/. P(y)

Main = ν(x) [ "p"[ "c"[ C(x) ] | P(x) ] ]

⟦ EXCLUDE = yes ⟧

C(x) = ( ! .exit x /*println("exited")*/. ) | ( ! .enter x /*println("entered")*/. )

P(x) = ( ! .expel x /*println("expelled")*/. ) | ( ! .accept x /*println("accepted")*/. )

Main = ν(x) "p"[ "c"[ C(x) ] | P(x) ]

⟦ EXCLUDE = yes ⟧

⟦ PUSH = REPLICATION ⟧

⟦ REPLICATION = (PARALLELISM,1) ⟧
⟦ REPLICATION = (LINEAR,yes) ⟧

C(x) = exit x /*println("exited")*/. s2s x?{y}. enter y /*println("entered")*/.

P(x) = expel x /*println("expelled")*/. s2s x!{νy}. accept y /*println("accepted")*/.

Main = ν(x) "p"[ "c"[ ! 2 c2p x?{y}/*log("c2p")*/. C(y) ] | ! 2 p2c x!{νy}/*println("p2c")*/. P(y) ]

⟦ POP = 1 ⟧

⟦ EXCLUDE = yes ⟧

C(x) = ! .exit x /*println("exited")*/. enter x /*println("entered")*/.

P(x) = ! .expel x /*println("expelled")*/. accept x /*println("accepted")*/.

Main = ν(x) "p"[ "c"[ C(x) ] | P(x) ]

⟦ EXCLUDE = yes ⟧

C(x) = exit x /*println("exited")*/.

P(x) = expel x /*println("expelled")*/.

Main = ν(x) ! 2 "p"[ "c"[ C(x) ] | P(x) ]

⟦ PARAMETER = (SNAPSHOT, y) ⟧
