@import cats.effect.std.Console

@def print(a: Any) = Console[F].print(a)

@def println(a: Any) = Console[F].println(a)

@def blocking(a: => Any) = Async[F].blocking(a)

                      ⟦ TYPECLASSES = (Async,cats.effect.std.Console,Parallel) ⟧

                                                     ⟦ INCLUDE = (zio,ziof,zs) ⟧

@def print(a: Any): UIO[Unit] = ZIO.attempt(Console.print(a))

@def println(a: Any) = ZIO.debug(a)

@def blocking(a: => Any): UIO[Any] = ZIO.attemptBlocking(a)

                                                                 ⟦ EXCLUDE = 0 ⟧{hanoi}

Main = ν(a,b,c)                                       \
     ( (¡.a!{"a"}.)                                   \
     | (¡.b!{"b"}.)                                   \
     | (¡.c!{"c"}.)                                   \
     | Hanoi(a,b,c,/*args.headOption.map(_.toInt)*/)  \
     )

Hanoi(a,b,c,m,n*) = ν(w)                                                        \
                  ( τ/* _ <- print(s"n = ${'m.fold("")(_.toString + "\n")}");   \
                       'n <- blocking {                                         \
                               try                                              \
                                 'm.getOrElse {                                 \
                                   scala.io.StdIn.readLine.toInt                \
                                 }                                              \
                               catch _ => -1                                    \
                             }                                                  \
                      */.                                                       \
                    Hanoi(a,b,c,n,w)                                            \
                  | w?{w}. τ/*_ <- println(s"#${'w} moves")*/.                  \
                  )

Move(from,to,z) = from?{x}.to?{y}.                       \
                  τ/*_ <- println(s"${'x} -> ${'y}")*/.  \
                                  z!{/*1*/}.

Hanoi(a,b,c,n,w) = if /*'n <= 1*/ = True                           \
                   then ν(z) ( Move(a,c,z) | z?{z}.w!{z}. )        \
                   else ν(x)                                       \
                      ( Hanoi(a,c,b,/*'n-1*/,x)                    \
                      | x?{x}. ν(y)                                \
                               ( Move(a,c,y)                       \
                               | y?{y}. ν(z)                       \
                                        ( Hanoi(b,a,c,/*'n-1*/,z)  \
                                        | z?{z}.w!{/*'x+'y+'z*/}.  \
                                        )                          \
                              )                                    \
                      )
