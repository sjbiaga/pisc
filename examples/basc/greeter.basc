# -*- indent-tabs-mode: nil; -*-

# https://github.com/alexj136/nodes/blob/master/examples/greeter

@val gen = new scala.util.Random

@def r = 1+math.abs(gen.nextInt%3)

⟦ INCLUDE = (ce,cef,zio,ziof,zs) ⟧

@given Conversion[`()`, String] = _.`()`[String]

⟦ INCLUDE = fs2 ⟧

@given Conversion[`()`[F], String] = _.`()`[String]

⟦ INCLUDE = (ce,cef) ⟧

@val nl: String => IO[String] = { it => IO.pure { s"$it\n" } }

@def print(a: Any) = IO.print(a)

@def blocking(a: => Any) = IO.blocking(a)

⟦ INCLUDE = fs2 ⟧

@import cats.effect.std.Console

@def nl: String => F[String] = { it => Async[F].pure { s"$it\n" } }

@def print(a: Any) = Console[F].print(a)

@def blocking(a: => Any) = Async[F].blocking(a)

⟦ TYPECLASSES = (Async,cats.effect.std.Console,Parallel) ⟧

⟦ INCLUDE = (zio,ziof,zs) ⟧

@val nl: String => Task[String] = { it => ZIO.succeed(s"$it\n") }

@def print(a: Any): UIO[Unit] = ZIO.attempt(Console.print(a))

@def blocking(a: => Any): UIO[Any] = ZIO.attemptBlocking(a)

                                                        ⟦ EXCLUDE = 0 ⟧{GREETER}

Main = ν(stdin, stdout) Greeter(stdin, stdout, "")

Greeter(stdin, stdout, line) = \
                             ( stdout ! { "What's your name?" }.stdin ? { name }. \
                                                                                  if /* 'name.isBlank */ = True \
                                                                                  then Greeter(stdin, stdout, line) \
                                                                                  else Chooser(stdout, name) \
                             ) \
                             | \
                             ( stdout ? { prompt } /* nl */. \
                               τ /* _    <- print('prompt); \
                                   'line <- blocking { scala.io.StdIn.readLine } */. \
                               stdin ! { line }. stdout ? { greet } /* nl */. \
                               τ/*_ <- print('greet)*/. \
                             )

Chooser(stdout, name) = τ@r.Greeter'(stdout, name)  \
                      + τ@r.Greeter"(stdout, name)  \
                      + τ@r.Greeter"'(stdout, name)

Greeter'(stdout, name) = \
                       ( ([/*name.substring(0,1).toUpperCase*/ = "Q"] stdout ! { "That's an unusual name." }.)  \
                       + ([name = "Voldemort"] stdout ! { "WARNING! LORD VOLDEMORT IS HERE!" }.)                \
                       + ([/*name.substring(0,1).toUpperCase*/ ≠ "Q"]                                           \
                          [name ≠ "Voldemort"] stdout ! { /*s"Hello ${'name}!"*/ }.)                            \
                       )

Greeter"(stdout, name) =                                                          \
                       ( if /*name.substring(0,1).toUpperCase*/ = "Q"             \
                         then stdout ! { "That's an unusual name." }.             \
                         else                                                     \
                           if name = "Voldemort"                                  \
                           then stdout ! { "WARNING! LORD VOLDEMORT IS HERE!" }.  \
                           else stdout ! { /*s"Hello ${'name}!"*/ }.              \
                       )

Greeter"'(stdout, name) =                                                       \
                        ( /*name.substring(0,1).toUpperCase*/ = "Q"             \
                          ? stdout ! { "That's an unusual name." }.             \
                          :                                                     \
                            name = "Voldemort"                                  \
                            ? stdout ! { "WARNING! LORD VOLDEMORT IS HERE!" }.  \
                            : stdout ! { /*s"Hello ${'name}!"*/ }.              \
                        )
