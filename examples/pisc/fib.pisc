# -*- indent-tabs-mode: nil; -*-

@import eu.timepit.refined.numeric.*

@val max = 13

@val gen = new scala.util.Random

@def random = 3+gen.nextLong(max)

                                                    ⟦ INCLUDE = (ce,zio,kk,zs) ⟧

@given Conversion[`()`, Long] = _.`()`[Long]

                                                       ⟦ INCLUDE = (fs2,monix) ⟧

@given [F[_]]: Conversion[`()`[F], Long] = _.`()`[Long]

                                                               ⟦ INCLUDE = fs2 ⟧

@import cats.effect.std.Console

@def println[F[_]: Console](a: Any) = Console[F].println(a)

                                      ⟦ TYPECLASSES = (Async,Console,Parallel) ⟧

                                                             ⟦ INCLUDE = monix ⟧

@def println[F[_]: Concurrent](a: Any) = Concurrent[F].delay(Console.println(a))

                                                                ⟦ INCLUDE = zs ⟧

@def println(a: Any) = ZIO.debug(a)

                                                                 ⟦ EXCLUDE = 0 ⟧{fib}

Main = 1 * 1 * ν(num) Main(num)

Main(num) =                                                            \
          ( (!.num(n).ν(out) ( Fib(n, out)                             \
                             | out(fib: Long /* NonNegative */).       \
                               τ/*println(s"fib(${'n}) = ${'fib}")*/.  \
                               num</*random*/>.                        \
                             )                                         \
            )                                                          \
          | num</*random*/>.                                           \
          )                                                            \

Fib(n, out) = τ/*println(s"n=${'n}")*/.  \
              ν(f)                       \
              ( Fibonacci(f, n)          \
              | f(res).out<res>.         \
              )                          \

Fibonacci(f, n) = if /*'n < 2*/ = True         \
                  then                         \
                    f<n>.                      \
                  else                         \
                    ν(g)ν(h)                   \
                    ( Fibonacci(g, /*'n-1*/)   \
                    | Fibonacci(h, /*'n-2*/)   \
                    | g(p).h(r).f</*'p+'r*/>.  \
                    )                          \
