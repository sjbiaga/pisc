# -*- indent-tabs-mode: nil; -*-

# ./examples $ pi_ hanoi.scala

⟦ include = (ce,zio,zs) ⟧

@given Conversion[`()`, Int] = _.`()`[Int]
@given Conversion[`()`, Option[Int]] = _.`()`[Option[Int]]

⟦ include = (fs2,monix) ⟧

@given [F[_]]: Conversion[`()`[F], Int] = _.`()`[Int]
@given [F[_]]: Conversion[`()`[F], Option[Int]] = _.`()`[Option[Int]]

⟦ include = ce ⟧

@val ! : String => IO[String] = { _ => IO.canceled.as("") }

@def print(a: Any) = IO.print(a)

@def println(a: Any) = IO.println(a)

@def blocking(a: => Any) = IO.blocking(a)

⟦ include = fs2 ⟧

⟦ typeclasses = (Async,Console,Parallel) ⟧

@import cats.effect.std.Console

@def ![F[_]: Async]: String => F[String] = { _ => Async[F].pure(null) }

@def print[F[_]: Console](a: Any) = Console[F].print(a)

@def println[F[_]: Console](a: Any) = Console[F].println(a)

@def blocking[F[_]: Async](a: => Any) = Async[F].blocking(a)

⟦ include = monix ⟧

⟦ typeclasses = (Concurrent,ContextShift,Parallel,Timer,TaskLift,TaskLike) ⟧

@def ![F[_]: Concurrent]: String => F[String] = { _ => Concurrent[F].pure(null) }

@def print[F[_]: Concurrent](a: Any) = Concurrent[F].delay(Console.print(a))

@def println[F[_]: Concurrent](a: Any) = Concurrent[F].delay(Console.println(a))

@def blocking[F[_]: Concurrent](a: => Any) = Concurrent[F].delay(a)

⟦ include = (zio,zs) ⟧

@def print(a: Any): UIO[Unit] = ZIO.attempt(Console.print(a))

@def println(a: Any) = ZIO.debug(a)

@def blocking(a: => Any): UIO[Any] = ZIO.attemptBlocking(a)

⟦ include = zio ⟧

@val ! : String => Task[String] = { _ => ZIO.interrupt.as("") }

⟦ include = zs ⟧

@given [A]: Conversion[Task[A], UIO[A]] = _.either.map(_.right.get)

@val ! : String => Task[String] = { _ => ZIO.succeed(null) }

⟦ exclude = 0 ⟧

⟦ replication = (parallelism,1) ⟧

Main = ν(a,b,c)                                       \
     ( (!.a<"a">.)                                    \
     | (!.b<"b">.)                                    \
     | (!.c<"c">.)                                    \
     | Hanoi(a,b,c,/*args.headOption.map(_.toInt)*/)  \
     )

Hanoi(a,b,c,m,n*) = ν(w)                                                      \
                ( τ/* _ <- print(s"n = ${'m.fold("")(_.toString + "\n")}");   \
                     'n <- blocking {                                         \
                             try                                              \
                               'm.getOrElse {                                 \
                                 scala.io.StdIn.readLine.toInt                \
                               }                                              \
                             catch _ => -1                                    \
                           }                                                  \
                    */.                                                       \
                  Hanoi(a,b,c,n,w)                                            \
                | w(w).                                                       \
                  τ/*_ <- println(s"#${'w} moves")*/.                         \
                  ( a(a)/*!*/. | b(b)/*!*/. | c(c)/*!*/. )                    \
                )


Move(from,to,z) = from(x).to(y).                         \
                  τ/*_ <- println(s"${'x} -> ${'y}")*/.  \
                                z</*1*/>.

Hanoi(a,b,c,n,w) = if /*'n <= 1*/ = True                         \
                   then ν(z) ( Move(a,c,z) | z(z).w<z>. )        \
                   else ν(x)                                     \
                      ( Hanoi(a,c,b,/*'n-1*/,x)                  \
                      | x(x). ν(y)                               \
                              ( Move(a,c,y)                      \
                              | y(y). ν(z)                       \
                                      ( Hanoi(b,a,c,/*'n-1*/,z)  \
                                      | z(z).w</*'x+'y+'z*/>.    \
                                      )                          \
                              )                                  \
                      )
