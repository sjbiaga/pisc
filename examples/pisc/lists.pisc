# ./examples $ pi_ lists.scala -- 1 2  3 5

@import eu.timepit.refined.collection.*
@import eu.timepit.refined.numeric.*

                                                               ⟦ INCLUDE = fs2 ⟧

@import cats.effect.std.Console

@def println[F[_]: Console](a: Any) = Console[F].println(a)

                                      ⟦ TYPECLASSES = (Async,Console,Parallel) ⟧

                                                             ⟦ INCLUDE = monix ⟧

@def println[F[_]: Concurrent](a: Any) = Concurrent[F].delay(Console.println(a))

                                                                ⟦ INCLUDE = zs ⟧

@def println(a: Any) = ZIO.debug(a)

                                                                 ⟦ EXCLUDE = 0 ⟧{lists}

Main = ν(ch)                                     \
     ( Client(ch, /*args.map(_.toInt).toList*/)  \
     | Server(ch)                                \
     )

Client(ch, l) = ch<l>.

Server(ch) = !.ch(list: List[Int] /* Size[Even] */).                   \
             if /*'list.nonEmpty*/ = True                              \
             then                                                      \
               list::(head1, head2, tail) /*println('head1+'head2)*/.  \
               ch<tail>.                                               \
             else                                                      \
               ch<>.
