# ./examples $ pi -go lists_go.gala -- 1 2 3 5

@import "strconv"

@func parse(text string) Try[int] { strconv.Atoi(text) }

@func toInt(text string) Go_NamePi { Go_IntPi(parse(text).ToOption().Get()) }

@func foreach(channel Go_NamePi, list List[Go_NamePi]) Go_TrampolinePi[Go_NamePi] {
@    Go_CallPi(() => {
@        channel match {
@            case Go_QueuePi(it) => {
@                list.ForEach((item) => it.Go_EnqueuePi(item).Run())
@                it.Go_EnqueuePi(Go_NothingPi()).Run()
@            }
@            case it => Panic(it)
@        }
@        Go_returnPi
@    })
@}

                                                                 ⟦ EXCLUDE = 0 ⟧{lists_go}

Main = ν(ch)                                         \
     ( τ/*bind _ = foreach(ch, args.Map(toInt)) */.  \
     | Sum(ch, /*0*/)                                \
     )

Sum(ch, sum) = ch(item). if /* 'item.IsNothing() */ = True then τ/* bind _ = PrintLn('sum.ToInt()) */.  \
                         else Sum(ch, /*Go_IntPi('sum.ToInt() + 'item.ToInt())*/)
