# -*- indent-tabs-mode: nil; -*-

                                                                 ⟦ EXCLUDE = 0 ⟧{sem2_go}

################################################################# Semaphore ✔ ##

⟦ EXCLUDE = NO ⟧

Sem(s) = ! 2* .s(r). r(r). τ/*bind _ = 'r.PrintLn()*/.

##################################################################### Clients ##

####################################################################### Macro ##

⟦ EXCLUDE = YES ⟧

⟦ 'n ^ 'd ⟧(s) = τ/*bind _ = Go_PacePi('d, time.Millisecond)*/. ! 1,second .s<νr>. τ/*bind _ = PrintLn('n + ".acq")*/. τ/*bind _ = Go_PacePi('d, time.Millisecond)*/. r</*Go_StringPi('n + ".rel")*/>.

Main = ν(s) ( Sem(s) | ⟦ "P" ^ 100 ⟧ | ⟦ "Q" ^ 200 ⟧ | ⟦ "R" ^ 300 ⟧ )

####################################################################### Agent ##

⟦ EXCLUDE = YES ⟧

Main(s, n, d) = τ/*bind _ = Go_PacePi('d.ToInt64(), time.Millisecond)*/. ! 1,second .s<νr>. τ/*bind _ = PrintLn('n.ToString() + ".acq")*/. τ/*bind _ = Go_PacePi('d.ToInt64(), time.Millisecond)*/. r</*Go_StringPi('n.ToString() + ".rel")*/>.

Main = ν(s) ( Sem(s) | Main(s, "P", 100) | Main(s, "Q", 200) | Main(s, "R", 300) )

############################################################### Macro / Agent ##

⟦ EXCLUDE = NO ⟧

⟦ 'n ^ 'd ⟧(s) = τ/*bind _ = Go_PacePi('d, time.Millisecond)*/. ! 1,second .s<νr>. τ/*bind _ = PrintLn('n + ".acq")*/. τ/*bind _ = Go_PacePi('d, time.Millisecond)*/. r</*Go_StringPi('n + ".rel")*/>.

P(s) = ⟦ "P" ^ 100 ⟧
Q(s) = ⟦ "Q" ^ 200 ⟧
R(s) = ⟦ "R" ^ 300 ⟧

Main = ν(s) ( Sem(s) | P(s) | Q(s) | R(s) )
