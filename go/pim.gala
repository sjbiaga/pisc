// -*- indent-tabs-mode: nil; -*-

package pi

import (
    "context"
    "github.com/marusama/cyclicbarrier"
    "golang.org/x/sync/semaphore"
    "martianoff/gala/go_interop"
)

func Go_SilentPi(
    ctx context.Context,
    parallelism int64,
    body func () Go_TrampolinePi[Go_NamePi],
    code func () Go_TrampolinePi[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        val cb = cyclicbarrier.New(int(parallelism))

        val first = semaphore.NewWeighted(1)

        var unfold func(int, *semaphore.Weighted) bool
        unfold = (remaining int, prev *semaphore.Weighted) bool => {
            val next *semaphore.Weighted =
                if (remaining == 1) first
                else {
                    val weighted = semaphore.NewWeighted(1)
                    weighted.TryAcquire(1)
                    weighted
                }
            val loop = () bool => {
                for true {
                    cb.Await(ctx)
                    prev.Acquire(ctx, 1)
                    code().Run()
                    next.Release(1)
                    body().Run()
                }
                true
            }
            if (remaining == 1) {
                loop()
            } else {
                go_interop.Spawn(() => loop())
                unfold(remaining - 1, next)
            }
        }

        unfold(int(parallelism), first)

        Go_returnPi
    })
}

func (self Go_NamePi) Go_BoundOutputPi(
    ctx context.Context,
    parallelism int64,
    body func (Go_NamePi) Go_TrampolinePi[Go_NamePi],
    code func () Go_TrampolinePi[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        self match {

            case Go_QueuePi(q) => {

                val cb = cyclicbarrier.New(int(parallelism))

                val first = semaphore.NewWeighted(1)

                var unfold func(int, *semaphore.Weighted) bool
                unfold = (remaining int, prev *semaphore.Weighted) bool => {
                    val next *semaphore.Weighted =
                        if (remaining == 1) first
                        else {
                            val weighted = semaphore.NewWeighted(1)
                            weighted.TryAcquire(1)
                            weighted
                        }
                    val loop = () bool => {
                        for true {
                            cb.Await(ctx)
                            prev.Acquire(ctx, 1)
                            val name = Go_QueuePi(Go_NewBlockingQueuePi())
                            q.Go_EnqueuePi(name).Run()
                            code().Run()
                            next.Release(1)
                            body(name).Run()
                        }
                        true
                    }
                    if (remaining == 1) {
                        loop()
                    } else {
                        go_interop.Spawn(() => loop())
                        unfold(remaining - 1, next)
                    }
                }

                unfold(int(parallelism), first)

            }

            case it => Panic(it)

        }

        Go_returnPi
    })
}

func (self Go_NamePi) Go_OutputPi(
    ctx context.Context,
    parallelism int64,
    body func () Go_TrampolinePi[Go_NamePi],
    code func () Go_TrampolinePi[Go_NamePi],
    value func () Go_NamePi
) Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        self match {

            case Go_QueuePi(q) => {

                val cb = cyclicbarrier.New(int(parallelism))

                val first = semaphore.NewWeighted(1)

                var unfold func(int, *semaphore.Weighted) bool
                unfold = (remaining int, prev *semaphore.Weighted) bool => {
                    val next *semaphore.Weighted =
                        if (remaining == 1) first
                        else {
                            val weighted = semaphore.NewWeighted(1)
                            weighted.TryAcquire(1)
                            weighted
                        }
                    val loop = () bool => {
                        for true {
                            cb.Await(ctx)
                            prev.Acquire(ctx, 1)
                            q.Go_EnqueuePi(value()).Run()
                            code().Run()
                            next.Release(1)
                            body().Run()
                        }
                        true
                    }
                    if (remaining == 1) {
                        loop()
                    } else {
                        go_interop.Spawn(() => loop())
                        unfold(remaining - 1, next)
                    }
                }

                unfold(int(parallelism), first)

            }

            case it => Panic(it)

        }

        Go_returnPi
    })
}

func (self Go_NamePi) Go_InputPi(
    ctx context.Context,
    parallelism int64,
    body func (Go_NamePi) Go_TrampolinePi[Go_NamePi],
    code func () Go_TrampolinePi[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        self match {

            case Go_QueuePi(q) => {

                val cb = cyclicbarrier.New(int(parallelism))

                val first = semaphore.NewWeighted(1)

                var unfold func(int, *semaphore.Weighted) bool
                unfold = (remaining int, prev *semaphore.Weighted) bool => {
                    val next *semaphore.Weighted =
                        if (remaining == 1) first
                        else {
                            val weighted = semaphore.NewWeighted(1)
                            weighted.TryAcquire(1)
                            weighted
                        }
                    val loop = () bool => {
                        for true {
                            cb.Await(ctx)
                            prev.Acquire(ctx, 1)
                            val name = q.Go_DequeuePi().Run().Get()
                            code().Run()
                            next.Release(1)
                            body(name).Run()
                        }
                        true
                    }
                    if (remaining == 1) {
                        loop()
                    } else {
                        go_interop.Spawn(() => loop())
                        unfold(remaining - 1, next)
                    }
                }

                unfold(int(parallelism), first)

            }

            case it => Panic(it)

        }

        Go_returnPi
    })
}

func (self Go_NamePi) Go_InputPi_(
    ctx context.Context,
    parallelism int64,
    fun func (Go_NamePi) Go_NamePi,
    body func (Go_NamePi) Go_TrampolinePi[Go_NamePi],
    code func () Go_TrampolinePi[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        self match {

            case Go_QueuePi(q) => {

                val cb = cyclicbarrier.New(int(parallelism))

                val first = semaphore.NewWeighted(1)

                var unfold func(int, *semaphore.Weighted) bool
                unfold = (remaining int, prev *semaphore.Weighted) bool => {
                    val next *semaphore.Weighted =
                        if (remaining == 1) first
                        else {
                            val weighted = semaphore.NewWeighted(1)
                            weighted.TryAcquire(1)
                            weighted
                        }
                    val loop = () bool => {
                        for true {
                            cb.Await(ctx)
                            prev.Acquire(ctx, 1)
                            val name = q.Go_DequeuePi_(fun).Run().Get()
                            code().Run()
                            next.Release(1)
                            body(name).Run()
                        }
                        true
                    }
                    if (remaining == 1) {
                        loop()
                    } else {
                        go_interop.Spawn(() => loop())
                        unfold(remaining - 1, next)
                    }
                }

                unfold(int(parallelism), first)

            }

            case it => Panic(it)

        }

        Go_returnPi
    })
}
