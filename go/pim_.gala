                var unfold func(int) Go_TrampolinePi[Go_NamePi]
                unfold = (remaining int) Go_TrampolinePi[Go_NamePi] => {
                    var loop func () Go_TrampolinePi[Go_NamePi]
                    loop = () Go_TrampolinePi[Go_NamePi] => {
                        bind _ = modulo.Acquire1(ctx)
                        bind _ = q.Go_EnqueuePi(ctx, value()).Unless(q.stop.Load()).FlatTapNone(modulo.Release1().Run())
                        bind _ = sleep().FlatTapNone(() => { q.stop.Store(true); modulo.Release1().Run() })
                        bind _ = modulo.Release1()
                        bind _ = body()
                        loop()
