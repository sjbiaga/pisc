// -*- indent-tabs-mode: nil; -*-

package pi

import (
    "context"
)

func Go_SilentPi(
    ctx context.Context,
    parallelism int64,
    body func () Go_TrampolinePi[Go_NamePi],
    sleep func () Go_TrampolinePi[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_Call_waitablePi(ctx, parallelism, (end) => {
        val modulo = Go_NewSemaphorePi(1)

        var unfold func(int) Go_TrampolinePi[Go_NamePi]
        unfold = (remaining int) Go_TrampolinePi[Go_NamePi] => {
            var loop func () Go_TrampolinePi[Go_NamePi]
            loop = () Go_TrampolinePi[Go_NamePi] => {
                bind _ = modulo.Acquire1(ctx)
                bind _ = sleep().FlatTapNone(modulo.Release1().Run())
                bind _ = modulo.Release1()
                bind _ = body()
                loop()
            }
            if (remaining == 1) {
                Go_Call_ReleasablePi(end, loop)
            } else {
                bind _ = Go_Spawn_ReleasablePi(end, loop)
                unfold(remaining - 1)
            }
        }

        unfold(int(parallelism))
    })
}

func (self Go_NamePi) Go_BoundOutputPi(
    ctx context.Context,
    parallelism int64,
    body func (Go_NamePi) Go_TrampolinePi[Go_NamePi],
    sleep func () Go_TrampolinePi[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_Call_waitablePi(ctx, parallelism, (end) =>
        self match {
            case Go_QueuePi(q) => {
                val modulo = Go_NewSemaphorePi(1)

                var unfold func(int) Go_TrampolinePi[Go_NamePi]
                unfold = (remaining int) Go_TrampolinePi[Go_NamePi] => {
                    var loop func () Go_TrampolinePi[Go_NamePi]
                    loop = () Go_TrampolinePi[Go_NamePi] => {
                        bind _ = modulo.Acquire1(ctx)
                        bind name = Go_NuPi()
                        bind _ = q.Go_EnqueuePi(ctx, name).Unless(q.stop.Load()).FlatTapNone(modulo.Release1().Run())
                        bind _ = sleep().FlatTapNone(() => { q.stop.Store(true); modulo.Release1().Run() })
                        bind _ = modulo.Release1()
                        bind _ = body(name)
                        loop()
                    }
                    if (remaining == 1) {
                        Go_Call_ReleasablePi(end, loop)
                    } else {
                        bind _ = Go_Spawn_ReleasablePi(end, loop)
                        unfold(remaining - 1)
                    }
                }

                unfold(int(parallelism))
            }

            case it => Panic(it)
        }
    )
}

func (self Go_NamePi) Go_OutputPi(
    ctx context.Context,
    parallelism int64,
    body func () Go_TrampolinePi[Go_NamePi],
    sleep func () Go_TrampolinePi[Go_NamePi],
