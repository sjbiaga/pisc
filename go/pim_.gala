                    if (remaining == 1) {
                        Go_Call_ReleasablePi(end, loop)
                    } else {
                        bind _ = Go_Spawn_ReleasablePi(end, loop)
                        unfold(remaining - 1)
                    }
                }

                unfold(int(parallelism))
            }

            case it => Panic(it)
        }
    )
}

func (self Go_NamePi) Go_InputPi(
    ctx context.Context,
    parallelism int64,
    body func (Go_NamePi) Go_TrampolinePi[Go_NamePi],
    sleep func () Go_TrampolinePi[Go_NamePi]
