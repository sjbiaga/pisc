// -*- indent-tabs-mode: nil; -*-

func Go_PacePi(amount int64, paceunit time.Duration) Option[bool] {
    time.Sleep(time.Duration(amount) * paceunit)
    Some(true)
}

func PrintNoLn(message any) Option[bool] {
    Print(message)
    Some(true)
}

func PrintLn(message any) Option[bool] {
    Println(message)
    Some(true)
}

func main() {
    val go_context = context.Background()
    Main(go_context, ListFromSlice(os.Args).Tail())
}


