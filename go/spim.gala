                        })

                        var loop func (bool) Go_TrampolinePi[Go_NamePi]
                        loop = (enabled bool) Go_TrampolinePi[Go_NamePi] => {
                            bind _ = Go_voidPi(FromError(moduloCB.Await(ctx)).ToOption())
                            bind _ = prevS.Acquire1(ctx)
                            bind _ =
                                if (!enabled)
                                    go_stochastic.Go_callbackPi(() => {
                                        val hmap = go_stochastic.Go_enabledMapPi
                                        Go_Call_unlockablePi(hmap.mutex, () => {
                                            hmap.hmap.Get(scope1.AsString() + key) match {
                                                case Some(Go_ActionPi(_, q)) =>
                                                    *hmap.hmap = hmap.hmap.Put(scope1.AsString() + key, Go_ActionPi(true, q))
                                                case it => Panic(it)
                                            }
                                            Go_returnPi
                                        })
                                    })
                                else
                                    Go_returnPi
                            bind opt = Go_AwaitPi(continue_at)
                            bind opt = Go_DonePi(opt.asOption()).FlatTapNone(nextS.Release1().Run())
                            continue_at = NewPromise[Go_NamePi]()
                            val ptr = opt.asPointer()
                            val barrier = ptr.barrier
                            bind _ = Go_voidPi(FromError(barrier.Await(go_stochastic.Go_ctxPi)).ToOption())
                            bind _ = Go_voidPi(FromError(barrier.Await(go_stochastic.Go_ctxPi)).ToOption())
                            bind _ = sleep()
                            bind _ = nextS.Release1()
                            bind name = Go_AwaitPi(result)
                            result = NewPromise[Go_NamePi]()
                            bind name = fun(name)
                            bind _ = body(name, scope2)
                            loop(false)
