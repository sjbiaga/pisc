                            bind _ = if (first) exclude(key, go_stochastic) else Go_returnPi
                            bind stop = if (first) Go_donePi(Go_BoolPi(false)) else Go_AwaitPi(moduloP)
                            bind _ = Go_returnPi.Unless(stop.AsBool())

                            val promise = NewPromise[Go_NamePi]()
                            if (!first) { promise.Success(go_OptionPi(None())) }
                            val reply = Go_ReplyPi(
                                promise = promise,
                                continue_at = &continue_at
                            )
                            val query = Go_QueryPi(
                               ether = ether,
                               polarity = Some(Right(&result)),
