// -*- indent-tabs-mode: nil; -*-

package ppi

import (
    "github.com/hut8/goq"
  . "martianoff/gala/collection_immutable"
    "math/big"
)

sealed type Go_NamePi {
    case Go_QueuePi(it Go_BlockingQueuePi)
    case Go_NumberPi(it *big.Float)
    case Go_BoolPi(it bool)
    case Go_StringPi(it string)
    default case Go_SlicePi(it []Go_NamePi = nil)
}

func Go_NamesPi(it ...Go_NamePi) Go_NamePi { Go_SlicePi(it) }

func Go_IntPi(it int) Go_NamePi {
    Go_NumberPi(big.NewFloat(float64(it)))
}

func (self Go_NamePi) Print() Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        self match {
            case Go_QueuePi(it) => Print(it)
            case Go_NumberPi(it) => Print(it)
            case Go_BoolPi(it) => Print(it)
            case Go_StringPi(it) => Print(it)
            case Go_SlicePi(it) => ListFromSlice(it).ForEach((it) => Print(it))
        }
        Go_returnPi
    })
}

func (self Go_NamePi) PrintLn() Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        self match {
            case Go_QueuePi(it) => Println(it)
            case Go_NumberPi(it) => Println(it)
            case Go_BoolPi(it) => Println(it)
            case Go_StringPi(it) => Println(it)
            case Go_SlicePi(it) => ListFromSlice(it).ForEach((it) => Println(it))
        }
        Go_returnPi
    })
}

func (self Go_NamePi) ToNumber() *big.Float {
    self match {
        case Go_NumberPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToFloat64() float64 {
    self match {
        case Go_NumberPi(it) =>
            it.Float64() match {
                case (f64, _) => f64
                case _ => Panic(it)
            }
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToInt64() int64 {
    self match {
        case Go_NumberPi(it) =>
            it.Int64() match {
                case (i64, _) => i64
                case _ => Panic(it)
            }
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToInt() int {
    int(self.ToInt64())
}

func (self Go_NamePi) ToBool() bool {
    self match {
        case Go_BoolPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToString() string {
    self match {
        case Go_StringPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToList() List[Go_NamePi] {
    self match {
        case Go_SlicePi(it) => ListFromSlice(it)
        case it => Panic(it)
    }
}

func (self Go_NamePi) IsEmpty() bool {
    self match {
        case Go_SlicePi(it) => it == nil
        case _ => false
    }
}

struct Go_BlockingQueuePi(
    queue *goq.Queue[Go_NamePi]
)

func Go_NewBlockingQueuePi() Go_BlockingQueuePi {
    Go_BlockingQueuePi(
        queue = goq.NewQueue[Go_NamePi]()
    )
}

func (self Go_BlockingQueuePi) Go_EnqueuePi(item Go_NamePi) Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        self.queue.Enqueue(item)
        if (item.IsEmpty())
            Go_nonePi
        else
            Go_returnPi
    })
}

func (self Go_BlockingQueuePi) Go_DequeuePi() Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        val item = self.queue.Dequeue()
        if (item.IsEmpty())
            Go_nonePi
        else
            Go_donePi(item)
    })
}

func (self Go_BlockingQueuePi) Go_DequeuePi_(f func (List[Go_NamePi]) List[Go_NamePi]) Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        val item = Go_SlicePi(f(self.queue.Dequeue().ToList()).ToGoSlice())
        if (item.IsEmpty())
            Go_nonePi
        else
            Go_donePi(item)
    })
}
