// -*- indent-tabs-mode: nil; -*-

package pi

import (
    "martianoff/gala/collection_mutable"
    "martianoff/gala/go_interop"
    "martianoff/gala/resource"
    "math/big"
    "sync"
)

sealed type Go_NamePi {
    case Go_QueuePi(it Go_BlockingQueuePi)
    case Go_NumberPi(it *big.Float)
    case Go_BooleanPi(it bool)
    case Go_StringPi(it string)
    default case Go_NothingPi()
}

func Go_IntPi(it int) Go_NamePi {
    Go_NumberPi(big.NewFloat(float64(it)))
}

func (self Go_NamePi) Print() Option[bool] {
    self match {
        case Go_QueuePi(it) => Print(it)
        case Go_NumberPi(it) => Print(it)
        case Go_BooleanPi(it) => Print(it)
        case Go_StringPi(it) => Print(it)
        case _ => Print()
    }
    Some(true)
}

func (self Go_NamePi) PrintLn() Option[bool] {
    self match {
        case Go_QueuePi(it) => Println(it)
        case Go_NumberPi(it) => Println(it)
        case Go_BooleanPi(it) => Println(it)
        case Go_StringPi(it) => Println(it)
        case _ => Println()
    }
    Some(true)
}

func (self Go_NamePi) ToNumber() *big.Float {
    self match {
        case Go_NumberPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToFloat64() float64 {
    self match {
        case Go_NumberPi(it) =>
            it.Float64() match {
                case (f64, _) => f64
                case _ => Panic(it)
            }
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToInt64() int64 {
    self match {
        case Go_NumberPi(it) =>
            it.Int64() match {
                case (i64, _) => i64
                case _ => Panic(it)
            }
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToInt() int {
    int(self.ToInt64())
}

func (self Go_NamePi) ToBoolean() bool {
    self match {
        case Go_BooleanPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToString() string {
    self match {
        case Go_StringPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) IsNothing() bool {
    self match {
        case Go_NothingPi() => true
        case _ => false
    }
}

struct Go_BlockingQueuePi(
    items *collection_mutable.Array[Go_NamePi],
    mu *go_interop.Mutex,
    notEmpty *sync.Cond,
    notFull *sync.Cond,
    stop *bool
)

func Go_NewBlockingQueuePi() Go_BlockingQueuePi {
    val lock = go_interop.NewMutex()
    var stop = false

    Go_BlockingQueuePi(
        items = collection_mutable.EmptyArray[Go_NamePi](),
        mu = lock,
        notEmpty = sync.NewCond(lock),
        notFull = sync.NewCond(lock),
        stop = &stop
    )
}

func (q Go_BlockingQueuePi) Go_EnqueuePi(item Go_NamePi) Option[bool] {
    resource.WithLock(q.mu, () => {
        if (item.Equal(Go_NothingPi())) {
            *q.stop = true
            None[bool]()
        } else {
            for q.items.Size() == 1 {
                q.notFull.Wait()
            }

            if (*q.stop) {
                None[bool]()
            } else {
                q.items.Append(item)

                q.notEmpty.Signal()

                Some(true)
            }
        }
    })
}

func (q Go_BlockingQueuePi) Go_DequeuePi() Option[Go_NamePi] {
    resource.WithLock(q.mu, () => {
        if (*q.stop) {
            None[Go_NamePi]()
        } else {
            for q.items.Size() == 0 {
                q.notEmpty.Wait()
            }

            val item = q.items.Get(0)
            q.items.RemoveAt(0)

            q.notFull.Signal()

            Some(item)
        }
    })
}

func (q Go_BlockingQueuePi) Go_DequeuePi_(f func (Go_NamePi) Go_NamePi) Option[Go_NamePi] {
    resource.WithLock(q.mu, () => {
        if (*q.stop) {
            None[Go_NamePi]()
        } else {
            for q.items.Size() == 0 {
                q.notEmpty.Wait()
            }

            var item = q.items.Get(0)
            q.items.RemoveAt(0)

            item = f(item)

            if (item.Equal(Go_NothingPi())) {
                *q.stop = true

                q.notFull.Signal()

                None[Go_NamePi]()
            } else {
                q.notFull.Signal()

                Some(item)
            }
        }
    })
}
