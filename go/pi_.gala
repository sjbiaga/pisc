// -*- indent-tabs-mode: nil; -*-

package pi

import (
    "github.com/jsouthworth/queue"
    "martianoff/gala/go_interop"
    "math/big"
)

sealed type Go_NamePi {
    case Go_QueuePi(it Go_BlockingQueuePi)
    case Go_NumberPi(it *big.Float)
    case Go_BooleanPi(it bool)
    case Go_StringPi(it string)
    default case Go_NothingPi()
}

func Go_IntPi(it int) Go_NamePi {
    Go_NumberPi(big.NewFloat(float64(it)))
}

func (self Go_NamePi) Print() Option[bool] {
    self match {
        case Go_QueuePi(it) => Print(it)
        case Go_NumberPi(it) => Print(it)
        case Go_BooleanPi(it) => Print(it)
        case Go_StringPi(it) => Print(it)
        case _ => Print()
    }
    Some(true)
}

func (self Go_NamePi) PrintLn() Option[bool] {
    self match {
        case Go_QueuePi(it) => Println(it)
        case Go_NumberPi(it) => Println(it)
        case Go_BooleanPi(it) => Println(it)
        case Go_StringPi(it) => Println(it)
        case _ => Println()
    }
    Some(true)
}

func (self Go_NamePi) ToNumber() *big.Float {
    self match {
        case Go_NumberPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToFloat64() float64 {
    self match {
        case Go_NumberPi(it) =>
            it.Float64() match {
                case (f64, _) => f64
                case _ => Panic(it)
            }
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToInt64() int64 {
    self match {
        case Go_NumberPi(it) =>
            it.Int64() match {
                case (i64, _) => i64
                case _ => Panic(it)
            }
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToInt() int {
    int(self.ToInt64())
}

func (self Go_NamePi) ToBoolean() bool {
    self match {
        case Go_BooleanPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToString() string {
    self match {
        case Go_StringPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) IsNothing() bool {
    self match {
        case Go_NothingPi() => true
        case _ => false
    }
}

struct Go_BlockingQueuePi(
    queue queue.Queue,
    mutex *go_interop.Mutex,
    stop *bool
)

func Go_NewBlockingQueuePi() Go_BlockingQueuePi {
    var stop = false

    Go_BlockingQueuePi(
        queue = queue.NewBlocking(0),
        mutex = go_interop.NewMutex(),
        stop = &stop
    )
}

type unlockable struct {
    mutex *go_interop.Mutex
}

func (self unlockable) Close() {
    self.mutex.Unlock()
}

func (self Go_BlockingQueuePi) Go_EnqueuePi(item Go_NamePi) Option[bool] {
    self.mutex.Lock()
    use unlock = unlockable(self.mutex)
    if (*self.stop) {
        None[bool]()
    } else if (item.Equal(Go_NothingPi())) {
        *self.stop = true
        None[bool]()
    } else {
        self.mutex.Unlock()
        self.queue.Enqueue(item)
        self.mutex.Lock()
        if (*self.stop) {
            None[bool]()
        } else {
            Some(true)
        }
    }
}

func (self Go_BlockingQueuePi) Go_DequeuePi() Option[Go_NamePi] {
    self.mutex.Lock()
    use unlock = unlockable(self.mutex)
    if (*self.stop) {
        None[Go_NamePi]()
    } else {
        self.mutex.Unlock()
        any(self.queue.Dequeue()) match {
            case item: Go_NamePi => {
                self.mutex.Lock()
                if (*self.stop) {
                    None[Go_NamePi]()
                } else if (item.Equal(Go_NothingPi())) {
                    *self.stop = true
                    None[Go_NamePi]()
                } else {
                    Some(item)
                }
            }
            case it => {
                self.mutex.Lock()
                it match { case _ => Panic(it) }
            }
        }
    }
}

func (self Go_BlockingQueuePi) Go_DequeuePi_(f func (Go_NamePi) Go_NamePi) Option[Go_NamePi] {
    self.mutex.Lock()
    use unlock = unlockable(self.mutex)
    if (*self.stop) {
        None[Go_NamePi]()
    } else {
        self.mutex.Unlock()
        any(self.queue.Dequeue()) match {
            case _item: Go_NamePi => {
                val item = f(_item)
                self.mutex.Lock()
                if (*self.stop) {
                    None[Go_NamePi]()
                } else if (item.Equal(Go_NothingPi())) {
                    *self.stop = true
                    None[Go_NamePi]()
                } else {
                    Some(item)
                }
            }
            case it => {
                self.mutex.Lock()
                it match { case _ => Panic(it) }
            }
        }
    }
}
