// -*- indent-tabs-mode: nil; -*-

package pi

import (
    "context"
    "github.com/hut8/goq"
    "github.com/marusama/cyclicbarrier"
    "martianoff/gala/go_interop"
    "math/big"
    "sync/atomic"
)

sealed type Go_NamePi {
    case Go_QueuePi(it Go_BlockingQueuePi)
    case Go_NumberPi(it *big.Float)
    case Go_BoolPi(it bool)
    case Go_StringPi(it string)
    default case Go_NothingPi()
}

func Go_IntPi(it int) Go_NamePi {
    Go_NumberPi(big.NewFloat(float64(it)))
}

func (self Go_NamePi) Print() Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        self match {
            case Go_QueuePi(it) => Print(it)
            case Go_NumberPi(it) => Print(it)
            case Go_BoolPi(it) => Print(it)
            case Go_StringPi(it) => Print(it)
            case _ => Print()
        }
        Go_returnPi
    })
}

func (self Go_NamePi) PrintLn() Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        self match {
            case Go_QueuePi(it) => Println(it)
            case Go_NumberPi(it) => Println(it)
            case Go_BoolPi(it) => Println(it)
            case Go_StringPi(it) => Println(it)
            case _ => Println()
        }
        Go_returnPi
    })
}

func (self Go_NamePi) ToNumber() *big.Float {
    self match {
        case Go_NumberPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToFloat64() float64 {
    self match {
        case Go_NumberPi(it) =>
            it.Float64() match {
                case (f64, _) => f64
                case _ => Panic(it)
            }
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToInt64() int64 {
    self match {
        case Go_NumberPi(it) =>
            it.Int64() match {
                case (i64, _) => i64
                case _ => Panic(it)
            }
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToInt() int {
    int(self.ToInt64())
}

func (self Go_NamePi) ToBool() bool {
    self match {
        case Go_BoolPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) ToString() string {
    self match {
        case Go_StringPi(it) => it
        case it => Panic(it)
    }
}

func (self Go_NamePi) IsNothing() bool {
    self match {
        case Go_NothingPi() => true
        case _ => false
    }
}

struct Go_BlockingQueuePi(
    queue *goq.Queue[Tuple[Go_NamePi, cyclicbarrier.CyclicBarrier]],
    stop *atomic.Bool
)

func Go_NewBlockingQueuePi() Go_BlockingQueuePi {
    var stop atomic.Bool

    Go_BlockingQueuePi(
        queue = goq.NewQueue[Tuple[Go_NamePi, cyclicbarrier.CyclicBarrier]](),
        stop = &stop
    )
}

func (self Go_BlockingQueuePi) Go_EnqueuePi(ctx context.Context, item Go_NamePi) Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        val b2 = cyclicbarrier.New(2)
        val it Tuple[Go_NamePi, cyclicbarrier.CyclicBarrier] = (item, b2)
        self.queue.Enqueue(it)
        bind _ = Go_voidPi(FromError(b2.Await(ctx)).ToOption())
        if (self.stop.Load())
            Go_nonePi
        else
            Go_returnPi
    })
}

func (self Go_BlockingQueuePi) Go_DequeuePi(ctx context.Context) Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        val (item, b2) = self.queue.Dequeue()
        Go_Call_awaitablePi(ctx, b2, () => {
            if (item.IsNothing()) {
                self.stop.Store(true)
                Go_nonePi
            } else {
                Go_donePi(item)
            }
        })
    })
}

func (self Go_BlockingQueuePi) Go_DequeuePi_(ctx context.Context, f func (Go_NamePi) Go_NamePi) Go_TrampolinePi[Go_NamePi] {
    Go_CallPi(() => {
        val (_item, b2) = self.queue.Dequeue()
        val item = f(_item)
        Go_Call_awaitablePi(ctx, b2, () => {
            if (item.IsNothing()) {
                self.stop.Store(true)
                Go_nonePi
            } else {
                Go_donePi(item)
            }
        })
    })
}
