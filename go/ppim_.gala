// -*- indent-tabs-mode: nil; -*-

package ppi

import (
    "context"
    "github.com/marusama/cyclicbarrier"
  . "martianoff/gala/collection_immutable"
)

func Go_SilentPi(
    ctx context.Context,
    parallelism int64,
    body func () Go_TrampolinePi[Go_NamePi],
    code func () Go_TrampolinePi[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_Call_waitablePi(ctx, parallelism, (end) => {
        val cb = cyclicbarrier.New(int(parallelism))

        val first = Go_NewSemaphorePi(1)

        var unfold func(int, Go_SemaphorePi) Go_TrampolinePi[Go_NamePi]
        unfold = (remaining int, prev Go_SemaphorePi) Go_TrampolinePi[Go_NamePi] => {
            val next =
                if (remaining == 1) first
                else {
                    val sem = Go_NewSemaphorePi(1)
                    sem.TryAcquire1().Run()
                    sem
                }
            var loop func () Go_TrampolinePi[Go_NamePi]
            loop = () Go_TrampolinePi[Go_NamePi] => {
                bind _ = Go_voidPi(FromError(cb.Await(ctx)).ToOption())
                bind _ = prev.Acquire1(ctx)
                bind _ = code()
                bind _ = next.Release1()
                bind _ = body()
                loop()
            }
            if (remaining == 1) {
                Go_Call_ReleasablePi(end, loop)
            } else {
                bind _ = Go_Spawn_ReleasablePi(end, loop)
                unfold(remaining - 1, next)
            }
        }

        unfold(int(parallelism), first)
    })
}

func (self Go_NamePi) Go_BoundOutputPi(
    ctx context.Context,
    arity int,
    parallelism int64,
    body func (List[Go_NamePi]) Go_TrampolinePi[Go_NamePi],
    code func () Go_TrampolinePi[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_Call_waitablePi(ctx, parallelism, (end) =>
        self match {
            case Go_QueuePi(q) => {
                val cb = cyclicbarrier.New(int(parallelism))

                val first = Go_NewSemaphorePi(1)

                var unfold func(int, Go_SemaphorePi) Go_TrampolinePi[Go_NamePi]
                unfold = (remaining int, prev Go_SemaphorePi) Go_TrampolinePi[Go_NamePi] => {
                    val next =
                        if (remaining == 1) first
                        else {
                            val sem = Go_NewSemaphorePi(1)
                            sem.TryAcquire1().Run()
                            sem
                        }
                    var loop func () Go_TrampolinePi[Go_NamePi]
                    loop = () Go_TrampolinePi[Go_NamePi] => {
                        bind _ = Go_voidPi(FromError(cb.Await(ctx)).ToOption())
                        bind _ = prev.Acquire1(ctx)
                        val names = ArrayTabulate[Go_NamePi](arity, (_) => Go_QueuePi(Go_NewBlockingQueuePi()))
                        bind _ = q.Go_EnqueuePi(ctx, Go_SlicePi(names.ToGoSlice()))
                        bind _ = code()
                        bind _ = next.Release1()
                        bind _ = body(names.ToList())
                        loop()
                    }
                    if (remaining == 1) {
                        Go_Call_ReleasablePi(end, loop)
                    } else {
                        bind _ = Go_Spawn_ReleasablePi(end, loop)
                        unfold(remaining - 1, next)
                    }
                }

                unfold(int(parallelism), first)
            }

            case it => Panic(it)
        }
    )
}

func (self Go_NamePi) Go_OutputPi(
    ctx context.Context,
    parallelism int64,
    body func () Go_TrampolinePi[Go_NamePi],
    code func () Go_TrampolinePi[Go_NamePi],
    value func () List[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_Call_waitablePi(ctx, parallelism, (end) =>
        self match {
            case Go_QueuePi(q) => {
                val cb = cyclicbarrier.New(int(parallelism))

                val first = Go_NewSemaphorePi(1)

                var unfold func(int, Go_SemaphorePi) Go_TrampolinePi[Go_NamePi]
                unfold = (remaining int, prev Go_SemaphorePi) Go_TrampolinePi[Go_NamePi] => {
                    val next =
                        if (remaining == 1) first
                        else {
                            val sem = Go_NewSemaphorePi(1)
                            sem.TryAcquire1().Run()
                            sem
                        }
                    var loop func () Go_TrampolinePi[Go_NamePi]
                    loop = () Go_TrampolinePi[Go_NamePi] => {
                        bind _ = Go_voidPi(FromError(cb.Await(ctx)).ToOption())
                        bind _ = prev.Acquire1(ctx)
                        bind _ = q.Go_EnqueuePi(ctx, Go_SlicePi(value().ToGoSlice()))
                        bind _ = code()
                        bind _ = next.Release1()
                        bind _ = body()
                        loop()
                    }
                    if (remaining == 1) {
                        Go_Call_ReleasablePi(end, loop)
                    } else {
                        bind _ = Go_Spawn_ReleasablePi(end, loop)
                        unfold(remaining - 1, next)
                    }
                }

                unfold(int(parallelism), first)
            }

            case it => Panic(it)
        }
    )
}

func (self Go_NamePi) Go_InputPi(
    ctx context.Context,
    parallelism int64,
    body func (List[Go_NamePi]) Go_TrampolinePi[Go_NamePi],
    code func () Go_TrampolinePi[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_Call_waitablePi(ctx, parallelism, (end) =>
        self match {
            case Go_QueuePi(q) => {
                val cb = cyclicbarrier.New(int(parallelism))

                val first = Go_NewSemaphorePi(1)

                var unfold func(int, Go_SemaphorePi) Go_TrampolinePi[Go_NamePi]
                unfold = (remaining int, prev Go_SemaphorePi) Go_TrampolinePi[Go_NamePi] => {
                    val next =
                        if (remaining == 1) first
                        else {
                            val sem = Go_NewSemaphorePi(1)
                            sem.TryAcquire1().Run()
                            sem
                        }
                    var loop func () Go_TrampolinePi[Go_NamePi]
                    loop = () Go_TrampolinePi[Go_NamePi] => {
                        bind _ = Go_voidPi(FromError(cb.Await(ctx)).ToOption())
                        bind _ = prev.Acquire1(ctx)
                        bind name = q.Go_DequeuePi(ctx)
                        bind _ = code()
                        bind _ = next.Release1()
                        bind _ = body(name.ToList())
                        loop()
                    }
                    if (remaining == 1) {
                        Go_Call_ReleasablePi(end, loop)
                    } else {
                        bind _ = Go_Spawn_ReleasablePi(end, loop)
                        unfold(remaining - 1, next)
                    }
                }

                unfold(int(parallelism), first)
            }

            case it => Panic(it)
        }
    )
}

func (self Go_NamePi) Go_InputPi_(
    ctx context.Context,
    parallelism int64,
    fun func (List[Go_NamePi]) List[Go_NamePi],
    body func (List[Go_NamePi]) Go_TrampolinePi[Go_NamePi],
    code func () Go_TrampolinePi[Go_NamePi]
) Go_TrampolinePi[Go_NamePi] {
    Go_Call_waitablePi(ctx, parallelism, (end) =>
        self match {
            case Go_QueuePi(q) => {
                val cb = cyclicbarrier.New(int(parallelism))

                val first = Go_NewSemaphorePi(1)

                var unfold func(int, Go_SemaphorePi) Go_TrampolinePi[Go_NamePi]
                unfold = (remaining int, prev Go_SemaphorePi) Go_TrampolinePi[Go_NamePi] => {
                    val next =
                        if (remaining == 1) first
                        else {
                            val sem = Go_NewSemaphorePi(1)
                            sem.TryAcquire1().Run()
                            sem
                        }
                    var loop func () Go_TrampolinePi[Go_NamePi]
                    loop = () Go_TrampolinePi[Go_NamePi] => {
                        bind _ = Go_voidPi(FromError(cb.Await(ctx)).ToOption())
                        bind _ = prev.Acquire1(ctx)
                        bind name = q.Go_DequeuePi_(ctx, fun)
                        bind _ = code()
                        bind _ = next.Release1()
                        bind _ = body(name.ToList())
                        loop()
                    }
                    if (remaining == 1) {
                        Go_Call_ReleasablePi(end, loop)
                    } else {
                        bind _ = Go_Spawn_ReleasablePi(end, loop)
                        unfold(remaining - 1, next)
                    }
                }

                unfold(int(parallelism), first)
            }

            case it => Panic(it)
        }
    )
}
