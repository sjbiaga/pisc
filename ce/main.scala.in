//package main.scala.in

import _root_.cats.effect.IO


object App extends _root_.cats.effect.IOApp:

  import _root_.scala.collection.immutable.{ List, Map }

  import _root_.cats.effect.{ ExitCode, Ref }
  import _root_.cats.effect.std.{ AtomicCell, PQueue, Queue, Semaphore }

  import `Π-dump`.*
  import `Π-loop`.*, `Π-loop`.given


  private val spicsp = "pisc.stochastic.communications.parallelism.level"
  private val spicbh = "pisc.stochastic.communications.batch.threshold"
  private val spicbt = "pisc.stochastic.communications.batch.timeout"


  private def run(args: List[String], parallelism: Int, threshold: Int, timeout: Int, started: Ref[IO, Long], batch: Ref[IO, Long])
                 (% : %, / : /, * : *, ** : **, ^ : ^, - : -, ! : !, & : &): IO[ExitCode] =
    val \ =
      if threshold > 0
      then { (it: IO[Unit]) => ^.use(_ => it >> *.release) }
      else { (it: IO[Unit]) => ^.use(_ => it >> peek(using %, **)(π.`π-wand`)) }
    ( for
        _ <- if threshold > 0
             then loopʹ(parallelism, threshold, timeout, started, batch)(using %, !, &, -, *, **, ^)(π.`π-wand`).background
             else loop0(parallelism, timeout, started)(using %, !, &, -, *, **)(π.`π-wand`).background
        _ <- poll(using %, /, \).background
        _ <- dump(using %, !, -).background
      yield
        ()
    ).use { _ =>
      for
        ^ <- π.`π-uuid`
        _ <- π.`π-supervised`(π.Main(args*)(using ^)(using %, /, \))
        x <- !.get
      yield
        x
    }

  override def run(args: List[String]): IO[ExitCode] =
    val p = if sys.Prop.IntProp(spicsp).isSet
            then sys.Prop.IntProp(spicsp).value
            else π.`π-parallelism`
    val h = if sys.Prop.IntProp(spicbh).isSet
            then sys.Prop.IntProp(spicbh).value
            else π.`π-batch-threshold`
    val t = if sys.Prop.IntProp(spicbt).isSet
            then sys.Prop.IntProp(spicbt).value
            else π.`π-batch-timeout`
    for
      % <- AtomicCell[IO].of(Map[String, Int | (Boolean, +)]())
      / <- Queue.unbounded[IO, ((String, String), +)]
      * <- Semaphore[IO](0)
      ** <- PQueue.unbounded[IO, (Int, List[((String, String), ++++)])]
      - <- Queue.unbounded[IO, Option[(Long, ((Long, Long), Long), (String, String), (Double, Double))]]
      ! <- IO.deferred[ExitCode]
      & <- IO.ref(0L)
      n <- IO.ref(0L)
      ^ <- Semaphore[IO](1)
      b <- IO.ref(0L)
      _ <- `π-enable`(π.`π-main`)(using %)
      x <- run(args, p, h, t, n, b)(%, /, *, **, ^.permit, -, !, &)
    yield
      x


object π:

  import _root_.scala.collection.immutable.{ List => πLs }
  import _root_.scala.concurrent.duration.*

  import _root_.cats.instances.list.*
  import _root_.cats.syntax.all.*

  import _root_.cats.effect.std.{ Semaphore, UUIDGen }
  import _root_.cats.effect.syntax.all.*

  import _root_.eu.timepit.refined.*

  import sΠ.*

  import `Π-loop`.{ %, /, \ }
  import `Π-stats`.{ ∞, `ℝ⁺`, ⊤ }


  extension (self: πLs[IO[?]])
    private[π] inline def πparSequence: IO[Unit] =
      self.parSequenceVoid

  val `π-uuid`: IO[String] =
    UUIDGen.randomString[IO]

  def `π-supervised`(io: => IO[Any]): IO[Unit] =
    _root_.cats.effect.std.Supervisor[IO](await = true)
      .use(_.supervise(io))
      .flatMap(_.join.void)


