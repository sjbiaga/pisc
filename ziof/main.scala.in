//package main.scala.in

import _root_.cats.effect.std.Semaphore
import _root_.zio.interop.catz.generic.*
import _root_.zio.{ Promise, UIO, ZIO }


object App extends _root_.zio.ZIOAppDefault:

  import _root_.scala.collection.immutable.{ List, Map }

  import _root_.zio.{ ExitCode, Queue, Ref, Semaphore => SemaphoreZIO }

  import _root_.zio.ZIOAppArgs

  import `Π-dump`.*
  import `Π-loop`.*


  private val spicsp = "pisc.stochastic.communications.parallelism.level"
  private val spicbh = "pisc.stochastic.communications.batch.threshold"
  private val spicbt = "pisc.stochastic.communications.batch.timeout"


  private def run(args: List[String], parallelism: Int, threshold: Int, timeout: Int, started: Ref[Long], batch: Ref[Long])
                 (% : %, / : /, * : *, ** : **, ^ : ^, - : -, ! : !, & : &): UIO[ExitCode] =
    val \ =
      if threshold > 0
      then { (it: UIO[Unit]) => ^.withPermit(it *> *.release) }
      else { (it: UIO[Unit]) => ^.withPermit(it *> peek(using %, **)(π.`π-wand`)) }
    for
      l <- loop(parallelism, threshold, timeout, started, batch)(using %, !, &, -, *, **, ^)(π.`π-wand`).fork
      _ <- poll(using %, /, \).fork
      d <- dump(using %, !, -).fork
      ^ <- π.`π-uuid`
      _ <- π.Main(args*)(using ^)(using %, /, \)
      x <- !.await
      _ <- l.join
      _ <- d.join
    yield
      x

  override def run: ZIO[ZIOAppArgs, Nothing, Unit] =
    val p = if sys.Prop.IntProp(spicsp).isSet
            then sys.Prop.IntProp(spicsp).value
            else π.`π-parallelism`
    val h = if sys.Prop.IntProp(spicbh).isSet
            then sys.Prop.IntProp(spicbh).value
            else π.`π-batch-threshold`
    val t = if sys.Prop.IntProp(spicbt).isSet
            then sys.Prop.IntProp(spicbt).value
            else π.`π-batch-timeout`
    for
      args <- getArgs
      % <- Ref.Synchronized.make(Map[String, Int | +]())
      / <- Queue.unbounded[((String, String), +)]
      * <- Semaphore[UIO](0)
      ** <- Queue.unbounded[(() => Boolean, List[((String, String), ++++)])]
      - <- Queue.unbounded[Option[(Long, ((Long, Long), Long), (String, String), (Double, Double))]]
      ! <- Promise.make[Nothing, ExitCode]
      & <- Ref.make(0L)
      n <- Ref.make(0L)
      ^ <- SemaphoreZIO.make(1)
      b <- Ref.make(0L)
      _ <- `π-enable`(π.`π-main`)(using %)
      x <- run(args.toList, p, h, t, n, b)(%, /, *, **, ^, -, !, &)
      _ <- exit(x)
    yield
      ()


object π:

  import _root_.scala.collection.immutable.{ List => πLs }

  import _root_.zio.{ durationLong, Random, Task }
  import _root_.zio.concurrent.CyclicBarrier

  import _root_.eu.timepit.refined.*

  import sΠ.*, sΠ.given

  import `Π-loop`.{ %, /, \ }
  import `Π-stats`.{ ∞, `ℝ⁺`, ⊤ }


  extension (self: πLs[UIO[?]])
    private[π] inline def πcollectAllPar: UIO[Unit] =
      ZIO.collectAllParDiscard(self)

  val `π-uuid`: UIO[String] =
    Random.nextUUID.map(_.toString)


